<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.eventhorizon</groupId>
    <artifactId>spring-boot-starter-weblog</artifactId>
    <version>1.3.0-sb3</version>
    <packaging>jar</packaging>

    <name>spring-boot-starter-weblog</name>
    <description>
        Spring Boot starter that adds request-ID propagation, access-log exclusion filtering,
        an in-browser log viewer, and automatic Tomcat access-log compression to any
        Spring MVC application.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- ── Core web layer ──────────────────────────────────────────── -->
        <!-- Spring Boot 3.2: spring-boot-starter-web brings in embedded Tomcat transitively
             (the SB4 split into webmvc + spring-boot-tomcat doesn't exist on 3.x). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jackson is used by LogViewerController (parseExclusionLine) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ── Auto-configuration support ────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- ── Spring Security (optional — only activates WebLogSecurityAutoConfiguration
             when the consumer already depends on spring-boot-starter-security.
             Not pulled transitively into consumer apps.) ──────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── @ConfigurationProperties IDE hints (optional at runtime) → -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── Lombok (compile-only, not shipped) ─────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── Test ───────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!--
                DO NOT add spring-boot-maven-plugin here.
                This is a library jar — the repackage goal must not run or it
                produces a fat executable jar that cannot be used as a dependency.
            -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.springframework.boot</groupId>
                                    <artifactId>spring-boot-configuration-processor</artifactId>
                                    <version>3.2.4</version>
                                </path>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                    <version>1.18.30</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals><goal>testCompile</goal></goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                    <version>1.18.30</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — ljubodrag91/spring-boot-starter-weblog</name>
            <url>https://maven.pkg.github.com/ljubodrag91/spring-boot-starter-weblog</url>
        </repository>
    </distributionManagement>

    <scm>
        <connection>scm:git:https://github.com/ljubodrag91/spring-boot-starter-weblog.git</connection>
        <developerConnection>scm:git:git@github.com:ljubodrag91/spring-boot-starter-weblog.git</developerConnection>
        <url>https://github.com/ljubodrag91/spring-boot-starter-weblog</url>
    </scm>

</project>
